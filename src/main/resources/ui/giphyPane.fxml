<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import org.controlsfx.control.GridView?>
<?import java.lang.String?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<AnchorPane fx:id="giphyPane" styleClass="pane" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vinberts.gifvault.controllers.gihpy.GiphyController">
   <children>
      <VBox prefWidth="1000.0">
         <children>
            <HBox alignment="TOP_CENTER">
               <children>
                  <TextField fx:id="searchGiphyTextField" minWidth="350.0" promptText="Search Giphy" />
                  <ComboBox fx:id="giphyComboBox" promptText="search type">
                     <items>
                        <FXCollections fx:factory="observableArrayList">
                           <String fx:value="All Gifs" />
                           <String fx:value="Only Stickers" />
                        </FXCollections>
                     </items>
                     <padding>
                        <Insets left="10.0" top="5.0" />
                     </padding>
                  </ComboBox>
                  <Button onAction="#doGiphySearchAction" fx:id="searchButton" text="Go">
                     <HBox.margin>
                        <Insets left="10.0" top="4.0" />
                     </HBox.margin>
                  </Button>
                  <Button text="Get Trending" onAction="#getTrendingAction">
                     <HBox.margin>
                        <Insets left="80.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <GridView fx:id="gridView" maxHeight="810.0" prefWidth="1000.0" />
            <HBox alignment="CENTER" prefWidth="1000.0">
               <children>
                  <Button fx:id="prevPageButton" disable="true" text="Previous Page" onAction="#getPrevPageAction">
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="nextPageButton" disable="true" text="Next Page" onAction="#getNextPageAction">
                     <HBox.margin>
                        <Insets left="15.0" top="3.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
